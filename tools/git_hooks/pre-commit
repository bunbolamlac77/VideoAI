#!/usr/bin/env bash
# ==============================================================================
# .git/hooks/pre-commit — Pre-commit safety guard for AIVideo
# ==============================================================================
set -euo pipefail

# 1. Block large files (> 10 MB)
LARGE_FILES="$(git diff --cached --name-only --diff-filter=ACM | while read -r f; do
    if [ -f "$f" ]; then
        SZ="$(stat -f%z "$f" 2>/dev/null || stat -c%s "$f" 2>/dev/null || echo 0)"
        if [ "$SZ" -gt 10485760 ]; then
            echo "$f ($((SZ / 1024 / 1024)) MB)"
        fi
    fi
done)"

if [ -n "$LARGE_FILES" ]; then
    echo "❌ PRE-COMMIT ERROR: Phát hiện file vượt quá 10 MB trong staging area:"
    echo "$LARGE_FILES"
    echo "Model weights và file media lớn phải nằm trong .gitignore!"
    exit 1
fi

# 2. Block secret files. Public verification keys are intentionally published,
#    so `*_public_key.pem` is allowed; any other .pem (private keys) is blocked.
SECRET_FILES="$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(env|key|secret|token)$' || true)"
BLOCKED_PEM="$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.pem$' | grep -vE '_public_key\.pem$' || true)"
SECRET_FILES="${SECRET_FILES}${BLOCKED_PEM}"
if [ -n "$SECRET_FILES" ]; then
    echo "❌ PRE-COMMIT ERROR: Phát hiện file bí mật trong staging area:"
    echo "$SECRET_FILES"
    exit 1
fi

# 3. Quick Python Unit Test check
if [ -f "tests/test_framing_resilience.py" ]; then
    python3 -m unittest tests/test_framing_resilience.py >/dev/null 2>&1 || {
        echo "❌ PRE-COMMIT ERROR: Bộ unit test tests/test_framing_resilience.py không vượt qua!"
        exit 1
    }
fi

exit 0
