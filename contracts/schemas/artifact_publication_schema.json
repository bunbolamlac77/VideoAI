{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aivideo.local/schemas/artifact_publication_schema.json",
  "title": "ArtifactPublicationSchema",
  "description": "Defines canonical artifact publication lifecycle as specified in docs/05-ARCHITECTURE-AND-ROADMAP.md Section 6.",
  "type": "object",
  "required": [
    "publication_id",
    "project_id",
    "job_id",
    "attempt_id",
    "fencing_token",
    "artifact_type",
    "state",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "publication_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "attempt_id": {
      "type": "string",
      "format": "uuid"
    },
    "fencing_token": {
      "type": "integer",
      "minimum": 1
    },
    "artifact_type": {
      "type": "string",
      "enum": [
        "analysis_json",
        "proxy_video",
        "preview_render",
        "g2_source_mapping",
        "voice_wav",
        "tts_audio",
        "g3_cut_plan",
        "g4_captioned_cfr",
        "g4_conform_receipt",
        "g4_preview_mp4",
        "g5_captioned_cfr_4k",
        "g5_conform_receipt",
        "g5_final_mp4",
        "g5_handoff_drp",
        "g5_native_receipt",
        "g5_manual_handoff_drp"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "PREPARED",
        "MATERIALIZED",
        "VERIFIED",
        "COMMITTED"
      ]
    },
    "temp_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "canonical_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "sha256_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "byte_size": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "$comment": "Artifact types actually written by ProjectStore, the gate stores and the S08 publishers. Kept in sync by tests/test_artifact_schema_matches_code.py (audit P1-42)."
}
